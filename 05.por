programa {
  funcao inicio() {
    real n1,n2,n3, media 
    escreva("digite o consumo da maquinana 1:")
    leia(n1)
    escreva("digite o consumo da maquina 2:")
    leia(n2)
    escreva("digite o numero da maquina 3:")
    leia(n3)
    media=(n1 + n2 + n3) /3
    escreva(" media de consumo:",media)
  }
}

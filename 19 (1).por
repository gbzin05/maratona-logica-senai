programa {
  funcao inicio() {
    real nota1, nota2, nota3, media
    escreva("digite a nota do 1 teste\n")
    leia( nota1)
    escreva("digite a nota do 2 teste\n")
    leia(nota2)
    escreva("digite a nota do 3 teste\n")
    leia(nota3)
    media=(nota1+nota2+nota3)
    se(media>=7)
    escreva("operador ouro\n")
    senao
    escreva("reciclagem") 

    
  }
}

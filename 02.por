programa {
  funcao inicio() {
    real remessa1,remessa2,total
    escreva("controle de estoque\n")
    escreva(" digite a quantidade da primeira remessa:")
    leia(remessa1)
    escreva("digite a quantidade da segunda remessa:")
    leia(remessa2)
    total= remessa1+remessa2
    escreva("estoque total disponivel:",total)
  }
}

programa {
  funcao inicio() {
    cadeia usuario
    inteiro senha 
    escreva("digite usuario\n")
    leia(usuario)
    escreva("digite a senha\n")
    leia(senha)
    se((usuario=="adimin") e (senha == 1234))

    
    escreva("acesso concedido")
    senao
    escreva("acesso negado")
    
  }
}
